# Copy to .env and fill in real values. Never commit .env.

# Google AI Studio free-tier API key (aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Palpay Rail server base URL the agent talks to
PALPAY_RAIL_API_URL=http://localhost:4000

# Must match AGENT_API_KEY in server/.env
AGENT_API_KEY=generate-a-long-random-secret
