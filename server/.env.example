# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Supabase project settings (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PayPal sandbox app credentials (developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_ENVIRONMENT=SANDBOX

# Guest/card payment_source for zero-click ALLOWED captures (no buyer redirect).
# Generate at developer.paypal.com/dashboard > Testing Tools > Generate test card.
PAYPAL_SANDBOX_CARD_NUMBER=4032039xxxxxxxx
PAYPAL_SANDBOX_CARD_EXPIRY=2028-12
PAYPAL_SANDBOX_CARD_CVV=123
PAYPAL_SANDBOX_CARD_NAME=Palpay Rail Sandbox Buyer

# Google AI Studio free-tier API key (aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
# Flash-Lite has a much higher free-tier daily quota than full Flash models.
# If you hit a 429 on one model, swap this to another (e.g. gemini-2.5-flash).
GEMINI_MODEL=gemini-flash-lite-latest

# Firebase service account (Project Settings > Service Accounts > Generate new private key)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key\n-----END PRIVATE KEY-----\n"

# Shared secrets for service-to-service auth (generate with: openssl rand -hex 32)
AGENT_API_KEY=generate-a-long-random-secret
MANAGER_API_KEY=generate-a-long-random-secret
